# ==============================================================================
# PAPER BLOOM — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to `.env` for local development. Never commit `.env` to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# BROWSER-SAFE PUBLIC VARIABLES (prefixed with VITE_)
# These are bundled into the frontend and safe for visitors to see.
# ------------------------------------------------------------------------------

# Your Supabase Project URL (Supabase -> Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=

# Your Supabase anon / publishable key (Supabase -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=

# Set to "true" ONLY if you configured Google login in Supabase Auth Providers
VITE_ENABLE_GOOGLE_AUTH=false

# Public website URL (http://localhost:3000 locally, or your https://...vercel.app URL)
VITE_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SERVER-ONLY PRIVATE VARIABLES (NEVER prefix with VITE_, NEVER share publicly)
# ------------------------------------------------------------------------------

# Same Supabase Project URL (used by Vercel serverless functions in /api)
SUPABASE_URL=

# Same Supabase anon key (used for user-scoped JWT requests in /api)
SUPABASE_ANON_KEY=

# PRIVATE service_role / secret key (Supabase -> Project Settings -> API)
# Keep strictly on the server! Used only for atomic order placement & public form inserts.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL for CORS & redirects
SITE_URL=http://localhost:3000
